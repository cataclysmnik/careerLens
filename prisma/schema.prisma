// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  PLACEMENT_CELL
  COMPANY
}

enum AccountStatus {
  ACTIVE
  PENDING
}

enum JobListingStatus {
  PENDING // awaiting placement-cell approval
  APPROVED // visible to students
  REJECTED
  CLOSED // no longer accepting applications
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role          @default(STUDENT)
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  profile             Profile?
  evidence            StudentEvidence?
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  jobListings         JobListing[]          @relation("CompanyListings")
  reviewedListings    JobListing[]          @relation("ListingReviewer")
  applications        JobApplication[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  username            String?  @unique
  location            String?
  targetRole          String?
  experienceLevel     String?
  preferredIndustries String[] // Assuming PostgreSQL array support
  skills              String[]
  githubUsername      String?
  portfolioUrl        String?
  linkedinUrl         String?
  cgpa                Float?   // out of 10
  tenthPercentage     Float?
  twelfthPercentage   Float?
  leetcodeUsername    String?
  codeforcesHandle    String?
  codechefUsername    String?
  hackerrankUsername  String?
  gfgUsername         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentEvidence {
  id        String   @id @default(cuid())
  userId    String   @unique
  evidence  Json
  scoring   Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobListing {
  id             String           @id @default(cuid())
  companyId      String
  title          String
  location       String?
  employmentType String           // internship | full_time
  ctc            String?          // free text, e.g. "12 LPA" or "40k/month stipend"
  deadline       DateTime?
  description    String
  /// Requirements the LLM extracted from the description at creation (JobRequirements).
  /// Stored once so every applicant is scored against the same requirements.
  requirements   Json?
  status         JobListingStatus @default(PENDING)
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company      User             @relation("CompanyListings", fields: [companyId], references: [id], onDelete: Cascade)
  reviewedBy   User?            @relation("ListingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([companyId])
  @@index([status])
}

model JobApplication {
  id        String   @id @default(cuid())
  listingId String
  studentId String
  createdAt DateTime @default(now())

  listing JobListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  student User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([listingId, studentId])
  @@index([studentId])
}
