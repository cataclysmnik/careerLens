# Postgres connection string (e.g. from Supabase: Project Settings -> Database -> Connection string)
DATABASE_URL=

# NextAuth
# Generate with: npx auth secret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (see README for the Firebase/Google Cloud Console steps to obtain these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo override: "true" lets Company/Placement-Cell accounts skip approval
# (new signups are active immediately; pending accounts activate on sign-in)
NEXT_PUBLIC_DEMO_SKIP_APPROVAL=false

# Optional: raises the GitHub API rate limit used by the GitHub analyzer
GITHUB_TOKEN=
